generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The person who installed this Instance. Full access to every Merchant on it.
model Owner {
  id                          String                 @id @default(cuid())
  email                       String                 @unique
  passwordHash                String
  /// The currency used to visualize owner dashboard totals. Recorded amounts keep their source currency.
  displayCurrency             String                 @default("eur") @db.VarChar(3)
  // Set on every password change. Owner sessions issued before it are
  // refused, the only way to end a JWT session with no adapter behind it.
  passwordChangedAt           DateTime?
  createdAt                   DateTime               @default(now())
  merchants                   Merchant[]
  affiliateImportBatches      AffiliateImportBatch[]
  reconciledCommerceCheckouts CommerceCheckout[]     @relation("CommerceCheckoutReconciler")
}

model Merchant {
  id         String @id @default(cuid())
  ownerId    String
  owner      Owner  @relation(fields: [ownerId], references: [id])
  name       String
  // What the dashboard URL carries instead of the cuid. Derived from `name`
  // at creation and left alone afterwards, so renaming a product does not
  // break links already pointing at it. Unique per Owner, not globally: two
  // Owners on the same Instance can both have a product called "Docs".
  slug       String
  domain     String @unique // e.g. affiliates.instantgradient.com
  websiteUrl String // the actual product site affiliates promote, e.g. https://instantgradient.com — distinct from `domain`, which is only the tracking subdomain

  // The tracking integration is the one part of setup Supaffi cannot do for
  // the Merchant: the script goes on their site and client_reference_id goes
  // in their checkout code. Proving it works needs a real purchase carrying a
  // token, so it is recorded when that arrives rather than asserted up front.
  trackingVerifiedAt     DateTime? // first checkout that arrived carrying a Referral Token
  trackingVerifiedSeenAt DateTime? // when the Owner was shown that it had happened, so the moment is spent once
  onboardingCompletedAt  DateTime? // the owner left the last onboarding screen
  welcomeDismissedAt     DateTime? // the first-visit banner on the overview was closed

  programs                Program[]
  affiliates              Affiliate[]
  clicks                  Click[]
  affiliateLinks          AffiliateLink[]
  webhookEvents           WebhookEvent[]
  referredSubscriptions   ReferredSubscription[]
  paymentConnections      PaymentConnection[]
  paymentRecords          PaymentRecord[]
  commerceCheckouts       CommerceCheckout[]
  checkoutAttributions    CheckoutAttribution[]
  commerceIntegration     CommerceIntegration?
  /// Historical outbound delivery rows retained for referential integrity only.
  commerceEventDeliveries CommerceEventDelivery[]
  affiliateImportBatches  AffiliateImportBatch[]
  importedCommissions     ImportedCommission[]
  importedPayouts         ImportedPayout[]
  payouts                 Payout[]
  importRowResults        AffiliateImportRowResult[]
  createdAt               DateTime                   @default(now())

  @@unique([ownerId, slug])
  @@unique([id, ownerId])
}

enum CommissionDurationType {
  ONE_TIME
  FIXED_MONTHS
  FOREVER
}

model Program {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  // Appears in the public signup URL an Affiliate is sent, which is a link a
  // real person is asked to trust. Unique per Merchant, same derive-once rule
  // as Merchant.slug.
  slug       String

  defaultCommissionRate    Decimal                @db.Decimal(5, 2) // percentage, e.g. 20.00
  /// The default currency affiliates use to display dashboard amounts. Stored amounts remain unchanged.
  currency                 String                 @default("eur") @db.VarChar(3)
  /// Minimum mature commission balance, checked separately in each transaction currency.
  minimumPayoutAmount      Decimal                @default(0) @db.Decimal(18, 2)
  commissionDurationType   CommissionDurationType
  commissionDurationMonths Int? // only set when commissionDurationType = FIXED_MONTHS
  attributionWindowDays    Int                    @default(60)
  holdingPeriodDays        Int                    @default(30)
  // False keeps the public signup page closed, so a higher-paying tier is not
  // open to whoever guesses its slug. The Owner moves Affiliates in instead.
  signupOpen               Boolean                @default(true)

  affiliates             Affiliate[]
  affiliateTermOverrides AffiliateProgramTerms[]
  clicks                 Click[]
  commissions            Commission[]
  payouts                Payout[]
  importedCommissions    ImportedCommission[]
  importedPayouts        ImportedPayout[]
  createdAt              DateTime                @default(now())

  @@unique([merchantId, slug])
  @@unique([id, merchantId])
}

model Affiliate {
  id         String   @id @default(cuid())
  merchantId String // identity is scoped to the Merchant, not the Program — moving between Programs (e.g. Standard to VIP tier) keeps the same Affiliate row and history
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  programId  String // current Program assignment, reassignable
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  email                String
  name                 String?
  // Argon2id, same as the Owner's. Null for an Affiliate who signed up before
  // passwords existed, until the Owner sends them a password link.
  passwordHash         String?
  // Set when a password link replaces the password. Affiliate sessions issued
  // before it are refused, like the Owner's (see affiliateSessionIsCurrent).
  // Left null at signup: the session that signup starts is the one to keep.
  passwordChangedAt    DateTime?
  importSourceIdentity String?   @unique
  /// Null follows the current Program's currency; otherwise an affiliate-chosen dashboard display currency.
  displayCurrency      String?   @db.VarChar(3)
  payoutDetails        String? // freeform for v1 (PayPal email, IBAN, etc.), Merchant reads it manually

  links                AffiliateLink[]
  programTermOverrides AffiliateProgramTerms[]
  clicks               Click[]
  commissions          Commission[]
  payouts              Payout[]
  importedCommissions  ImportedCommission[]
  importedPayouts      ImportedPayout[]
  loginTokens          AffiliateLoginToken[]
  createdAt            DateTime                @default(now())

  @@unique([merchantId, email])
  // Supports AffiliateLink's composite foreign key, which prevents a link
  // from naming a Merchant different from its Affiliate's Merchant.
  @@unique([id, merchantId])
}

/// Optional terms for one Affiliate in one Program. These survive reassignment,
/// so historical commissions keep resolving the terms for their own Program.
model AffiliateProgramTerms {
  merchantId  String
  affiliateId String
  programId   String

  customCommissionRate             Decimal?                @db.Decimal(5, 2)
  commissionDurationTypeOverride   CommissionDurationType?
  commissionDurationMonthsOverride Int?
  attributionWindowDaysOverride    Int?
  holdingPeriodDaysOverride        Int?
  minimumPayoutAmountOverride      Decimal?                @db.Decimal(18, 2)

  affiliate Affiliate @relation(fields: [affiliateId, merchantId], references: [id, merchantId], onDelete: Cascade)
  program   Program   @relation(fields: [programId, merchantId], references: [id, merchantId], onDelete: Cascade)

  @@id([affiliateId, programId])
  @@index([merchantId, programId])
}

/// One shareable referral URL. An Affiliate starts with a primary link created
/// at signup and can add more, e.g. one pointing at /pricing for a review post.
///
/// The code lives here rather than on Affiliate so there is one source of truth
/// for it. Editing a code rewrites this row: the old code stops resolving
/// immediately and anything already shared with it stops earning. That is a
/// product decision, stated to the Affiliate in the edit dialog, not an
/// oversight (docs/design/affiliate-wireframes.md).
model AffiliateLink {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId, merchantId], references: [id, merchantId])

  code                    String // appears directly in a public ?via= URL, unique within its Merchant
  legacyAliases           String[] @default([])
  legacyQueryParamAliases String[] @default([])
  importSourceIdentity    String?  @unique

  commissionRateOverride           Decimal?                @db.Decimal(5, 2) // Legacy imported value; new Clicks use Affiliate or Program terms.
  commissionDurationTypeOverride   CommissionDurationType? // Legacy per-link value; new Clicks use Affiliate or Program terms.
  commissionDurationMonthsOverride Int? // Legacy per-link value; new Clicks use Affiliate or Program terms.
  attributionWindowDaysOverride    Int? // Legacy per-link value; new Clicks use Affiliate or Program terms.
  holdingPeriodDaysOverride        Int? // Legacy per-link value; new Clicks use Affiliate or Program terms.
  activeFrom                       DateTime?
  activeUntil                      DateTime?

  /// Path on the Merchant's site this link points at, e.g. "/pricing". Null is
  /// the site root. Display only: the tracking snippet reads ?via= from
  /// whatever page it is loaded on, so a destination needs no runtime support.
  destinationPath String?

  /// The link created at signup. Exactly one per Affiliate, and it cannot be
  /// deleted: the Merchant's dashboard shows it and the Affiliate's own.
  isPrimary Boolean @default(false)

  clicks    Click[]
  createdAt DateTime @default(now())

  @@unique([merchantId, code])
  @@index([affiliateId])
}

/// A password link the Owner copies from the dashboard and sends an Affiliate
/// themselves, to set a first password or replace a forgotten one. Named for
/// the emailed login links it used to hold.
model AffiliateLoginToken {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  tokenHash   String    @unique // SHA-256 of the raw token, which only ever exists in the copied link
  expiresAt   DateTime // createdAt + 3 days, time to send it by hand
  usedAt      DateTime? // set when the password is saved; a used or expired link is refused

  createdAt DateTime @default(now())

  @@index([affiliateId])
}

model Click {
  id                               String                  @id @default(cuid())
  merchantId                       String
  merchant                         Merchant                @relation(fields: [merchantId], references: [id])
  affiliateId                      String
  affiliate                        Affiliate               @relation(fields: [affiliateId, merchantId], references: [id, merchantId])
  // Immutable Program attribution, independent of later Affiliate reassignment.
  programId                        String
  program                          Program                 @relation(fields: [programId, merchantId], references: [id, merchantId], onDelete: NoAction)
  referralToken                    String                  @unique // the value passed into Stripe as client_reference_id — only used to match the FIRST checkout
  expiresAt                        DateTime // createdAt + the resolved Program/Affiliate attribution window, computed at insert
  commissionRateSnapshot           Decimal?                @db.Decimal(5, 2)
  commissionDurationTypeSnapshot   CommissionDurationType?
  commissionDurationMonthsSnapshot Int?
  holdingPeriodDaysSnapshot        Int?
  createdAt                        DateTime                @default(now())

  // Which link the visitor arrived through. Nullable so deleting a link does
  // not take its click history with it, and because affiliateId (not this) is
  // what the attribution and commission pipeline reads.
  linkId String?
  link   AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  // Legacy, read only. Before 0.2.5 the first checkout wrote the Customer here
  // and renewals were matched on it, which paid the wrong affiliate when two
  // products share a Stripe account and paid on subscriptions nobody referred.
  // Nothing writes it any more. It is read only to recognise a subscription
  // referred before the upgrade (src/lib/worker/referredSubscription.ts).
  stripeCustomerId String? @unique

  // When Supaffi finished asking Stripe which subscriptions this legacy click
  // referred, whatever the answer. Set once, so a customer's unreferred
  // subscriptions do not trigger the same Stripe reads on every invoice.
  legacyCheckedAt DateTime?

  // When the subscription this click brought was cancelled, if it ever was.
  // Nothing retroactive happens to commissions already earned; this exists so
  // both dashboards can say a referral stopped paying instead of leaving an
  // affiliate to watch their income end with no explanation.
  subscriptionCancelledAt DateTime?

  // When the Owner confirmed a self referral on one of this click's
  // commissions. From then on nothing this click brings earns: no checkout,
  // no renewal. Voiding the one row was not enough, the next renewal simply
  // earned again.
  fraudConfirmedAt DateTime?

  commissions           Commission[]
  referredSubscriptions ReferredSubscription[]
  commerceCheckouts     CommerceCheckout[]
  paymentRecords        PaymentRecord[]
  checkoutAttributions  CheckoutAttribution[]

  @@unique([id, merchantId])
  @@unique([id, merchantId, programId])
  @@index([stripeCustomerId])
  @@index([linkId])
  @@index([merchantId])
}

/// A subscription that a referred Checkout Session created. Renewals earn by
/// matching the invoice's subscription against this row, never the customer:
/// products sharing a Stripe account share customers, and a customer's other
/// subscriptions and one-off invoices were never referred.
///
/// Unique per Merchant, not globally, because every product on a shared
/// account receives its own copy of each event.
model ReferredSubscription {
  id                   String   @id @default(cuid())
  merchantId           String
  merchant             Merchant @relation(fields: [merchantId], references: [id])
  clickId              String
  click                Click    @relation(fields: [clickId], references: [id])
  stripeSubscriptionId String

  // The first time money moved on this subscription: the paid checkout's
  // Invoice (or PaymentIntent) id, or after a free trial the first invoice
  // with an amount. A program's duration belongs to the click, so the earliest
  // of these among a click's subscriptions is when its referral started
  // (src/lib/worker/referralDuration.ts). Null while a free trial has not
  // charged yet.
  firstPaymentRef String?
  firstPaidAt     DateTime?

  // When Stripe reported this subscription deleted.
  cancelledAt DateTime?

  // The Stripe products the referred checkout bought, read from the
  // subscription's items. Renewals earn only on this subscription's lines for
  // these products. Empty on rows recorded before 0.2.7, or when Stripe could
  // not say, until the next renewal fills it.
  stripeProductIds String[] @default([])

  createdAt DateTime @default(now())

  @@unique([merchantId, stripeSubscriptionId])
  @@index([clickId])
}

enum CommissionStatus {
  PENDING
  FLAGGED // self-referral signal detected (email/payment overlap with the Affiliate); blocks progress to PAYABLE until the Merchant confirms or dismisses
  PAYABLE
  PAID
  VOIDED
}

enum ProviderFeeSource {
  ACTUAL
  FALLBACK
}

model Commission {
  id          String    @id @default(cuid())
  affiliateId String
  // A migration-owned composite FK also matches affiliateId and merchantId.
  // Keep Prisma's relation single-column so merchantId stays optional in
  // generated create inputs; the Click trigger supplies the authoritative value.
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  // Filled from the required Click by a database trigger. Nullable in the
  // Prisma model so inserts can leave the authoritative value to the database.
  merchantId  String?
  // Like merchantId, derived from the Click and immutable for this commission.
  programId   String?
  program     Program?  @relation(fields: [programId, merchantId], references: [id, merchantId], onDelete: NoAction)
  clickId     String
  click       Click     @relation(fields: [clickId], references: [id])

  // Null for a normal Commission. Set on the negative rows an older version
  // wrote for a refund after payout. A paid commission is now final and none
  // are written; kept for an optional recovery setting on the roadmap.
  adjustsCommissionId String?
  adjustsCommission   Commission?  @relation("Adjustment", fields: [adjustsCommissionId], references: [id])
  adjustments         Commission[] @relation("Adjustment")

  stripePaymentRef String?        @unique // an Invoice ID for subscriptions, a PaymentIntent ID for one-time purchases (no Invoice exists for those) — null for adjustment rows, which aren't tied to a new payment
  paymentRecordId  String?        @unique
  paymentRecord    PaymentRecord? @relation(fields: [paymentRecordId], references: [id])
  // Eighteen digits because a single sale in a currency like VND or IDR can
  // pass the eight integer digits Decimal(10,2) allowed.
  amount           Decimal        @db.Decimal(18, 2) // negative for adjustment rows
  currency         String // ISO code, e.g. "usd", "eur" — never converted (see CONTEXT.md)
  // The sale the commission was earned on, major units, same currency: after
  // discounts, before tax and shipping. Rows written before 0.2.4 hold what
  // the customer paid including tax. Null for adjustments and older rows.
  saleAmount       Decimal?       @db.Decimal(18, 2)

  // What this commission was before any refund reduced it. Set at creation
  // and never changed again, so a second partial refund prorates against the
  // original rather than compounding against an already reduced figure. A
  // commission created after its refund already happened is written reduced,
  // with this holding the unreduced figure. Nullable for rows written before
  // this existed.
  grossAmount Decimal? @db.Decimal(18, 2)

  // Processor fee removed from the referred sale before applying the rate.
  // The amount uses the Commission currency; historical rows remain null.
  providerFeeAmount Decimal?           @db.Decimal(18, 3)
  providerFeeSource ProviderFeeSource?

  // The referred share of the charge, in Stripe minor units, capped at the
  // charge amount. Set at creation for a renewal so a later refund prorates
  // against only the revenue that earned, not the whole charge; a one-off
  // item or another product on the same charge is never taken back out of
  // this commission first. Null for checkout rows and rows written before
  // this existed, which keep the whole-charge proration they always used.
  referredChargeMinor BigInt?

  status     CommissionStatus @default(PENDING)
  payableAt  DateTime // createdAt + Program.holdingPeriodDays
  paidAt     DateTime?
  paidNote   String?          @db.VarChar(200)
  payoutId   String?
  payout     Payout?          @relation(fields: [payoutId, merchantId, affiliateId, programId, currency], references: [id, merchantId, affiliateId, programId, currency], onDelete: NoAction, onUpdate: Cascade)
  voidedAt   DateTime?
  voidReason String? // e.g. "refund", "confirmed self-referral"
  flagReason String? // e.g. "email:buyer@x.com affiliate@x.com" or "card"

  // When an open dispute began holding this commission back from payment.
  // Null when no dispute is open. A held row is never PAYABLE: opening a
  // dispute moves a PAYABLE row back to PENDING, and neither the sweep nor a
  // dismissed flag promotes a held row. See src/lib/worker/disputes.ts.
  disputeOpenedAt        DateTime?
  // Holds this commission while its associated hosted checkout has conflicting
  // provider invoice references. Separate from dispute and fraud review holds.
  checkoutConflictHeldAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, payableAt])
  @@index([programId, affiliateId, currency, status, payableAt])
  @@index([status, checkoutConflictHeldAt], map: "Commission_status_conflictHold_idx")
  // The sale handlers read a click's earlier commissions on every sale of a
  // program with a limited duration (src/lib/worker/referralDuration.ts).
  @@index([clickId, createdAt])
}

/// Owner-confirmed record of an external transfer; creating it never sends money.
model Payout {
  id                String       @id @default(cuid())
  merchantId        String
  merchant          Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  affiliateId       String
  affiliate         Affiliate    @relation(fields: [affiliateId, merchantId], references: [id, merchantId], onDelete: NoAction)
  programId         String
  program           Program      @relation(fields: [programId, merchantId], references: [id, merchantId], onDelete: NoAction)
  currency          String       @db.VarChar(3)
  total             Decimal      @db.Decimal(18, 2)
  paidAt            DateTime
  paymentMethod     String?      @db.VarChar(80)
  externalReference String?      @db.VarChar(200)
  note              String?      @db.VarChar(500)
  isException       Boolean      @default(false)
  exceptionReason   String?      @db.VarChar(500)
  commissions       Commission[]
  createdAt         DateTime     @default(now())

  // Commission's composite foreign key enforces that every linked row has
  // this exact Merchant, Affiliate, Program, and currency.
  @@unique([id, merchantId, affiliateId, programId, currency])
  @@index([merchantId, paidAt])
  @@index([affiliateId, programId, currency, paidAt])
}

// Postgres-only webhook queue (ADR 0007). Drained via SELECT ... FOR UPDATE SKIP LOCKED.
enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentProvider {
  STRIPE
  NOWPAYMENTS
}

enum PaymentConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum CommerceEventDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model WebhookEvent {
  id              String             @id @default(cuid())
  merchantId      String
  merchant        Merchant           @relation(fields: [merchantId], references: [id])
  provider        PaymentProvider    @default(STRIPE)
  providerEventId String
  payload         Json
  status          WebhookEventStatus @default(PENDING)
  attempts        Int                @default(0)
  lastError       String? // last failure message, for debugging FAILED rows
  nextAttemptAt   DateTime           @default(now()) // backoff scheduling and, while PROCESSING, the claim lease; the claim query filters on this
  createdAt       DateTime           @default(now())
  processedAt     DateTime?

  // Blocks duplicate delivery per Merchant and provider.
  @@unique([merchantId, provider, providerEventId])
  @@index([status, nextAttemptAt, createdAt])
  // Cleanup only deletes an old processed row when the same product has a
  // newer one, and looks that up once per row.
  @@index([merchantId, createdAt])
}

/// A referral code an Affiliate stopped using, by renaming or deleting the link
/// that carried it. Links already published with the old code keep circulating,
/// so handing it to a different Affiliate would give them every future click
/// and commission from someone else's posts. Only the Affiliate who retired it
/// may take it back, and doing so removes the row.
///
/// No foreign keys on purpose: a row must outlive the Affiliate and Merchant it
/// came from, since a code that ever resolved is never safe to reassign.
model RetiredLinkCode {
  id          String   @id @default(cuid())
  code        String
  affiliateId String
  merchantId  String
  retiredAt   DateTime @default(now())

  @@unique([merchantId, code])
  @@index([affiliateId])
}

/// One set of provider credentials and callback identity for a Merchant.
/// Ciphertext is copied as-is from legacy Stripe fields during the additive
/// migration; provider code owns encryption and rotation afterwards.
model PaymentConnection {
  id                 String                  @id @default(cuid())
  merchantId         String
  merchant           Merchant                @relation(fields: [merchantId], references: [id])
  provider           PaymentProvider
  // Connectivity and cutover activation are independent: a working provider
  // can be paused without forgetting its status or credentials.
  status             PaymentConnectionStatus @default(DISCONNECTED)
  enabled            Boolean                 @default(false)
  apiKeyEnc          String?
  webhookSecretEnc   String?
  // Used only when a payment event does not include a usable transaction fee.
  feeFallbackPercent Decimal?                @db.Decimal(5, 2)
  externalEndpointId String?
  webhookRouteId     String                  @unique @default(cuid())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  checkouts CommerceCheckout[]
  payments  PaymentRecord[]

  @@unique([merchantId, provider])
  // Referenced by the composite foreign keys on provider-owned rows.
  @@unique([id, merchantId, provider])
}

/// A commerce order's idempotent request and hosted invoice. The stored input
/// fields and digest let retries reproduce the original provider request and
/// identical calls return the existing destination.
model CommerceCheckout {
  id                            String            @id @default(cuid())
  merchantId                    String
  merchant                      Merchant          @relation(fields: [merchantId], references: [id])
  connectionId                  String
  provider                      PaymentProvider
  connection                    PaymentConnection @relation(fields: [connectionId, merchantId, provider], references: [id, merchantId, provider])
  sourceOrderId                 String
  clickId                       String?
  click                         Click?            @relation(fields: [clickId, merchantId], references: [id, merchantId], onDelete: Restrict)
  amount                        Decimal           @db.Decimal(18, 2)
  currency                      String
  successUrl                    String
  cancelUrl                     String
  hostedCheckoutRef             String?
  alternateCheckoutRef          String?
  hostedCheckoutUrl             String?
  status                        String            @default("PENDING")
  idempotencyDigest             String
  attempts                      Int               @default(0)
  lastCreationError             String?
  nextAttemptAt                 DateTime?
  reconciliationResolution      String?
  refundReconciliationPendingAt DateTime?
  reconciledAt                  DateTime?
  reconciledByOwnerId           String?
  reconciledByOwner             Owner?            @relation("CommerceCheckoutReconciler", fields: [reconciledByOwnerId], references: [id], onDelete: SetNull)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  payments PaymentRecord[]

  @@unique([merchantId, provider, sourceOrderId])
  @@unique([id, merchantId])
  @@index([status, nextAttemptAt])
  @@index([reconciliationResolution, reconciledAt])
  @@index([merchantId, provider, status, updatedAt, id])
}

/// Provider checkout references captured by the merchant site's tracking
/// script before redirecting the customer to the hosted checkout. This is
/// Attribution metadata only; payment facts are verified with the provider.
model CheckoutAttribution {
  id                  String          @id @default(cuid())
  merchantId          String
  merchant            Merchant        @relation(fields: [merchantId], references: [id])
  provider            PaymentProvider
  providerCheckoutRef String          @db.VarChar(255)
  clickId             String
  click               Click           @relation(fields: [clickId, merchantId], references: [id, merchantId], onDelete: Restrict)
  createdAt           DateTime        @default(now())

  @@unique([merchantId, provider, providerCheckoutRef], map: "CheckoutAttribution_merchant_provider_ref_key")
  @@index([clickId])
}

/// Provider-neutral facts about a payment, separate from the affiliate ledger.
/// Provider references and source-order identities are merchant scoped; nullable
/// values retain PostgreSQL's multiple-NULL behavior for unreconciled records.
model PaymentRecord {
  id             String            @id @default(cuid())
  merchantId     String
  merchant       Merchant          @relation(fields: [merchantId], references: [id])
  connectionId   String
  provider       PaymentProvider
  connection     PaymentConnection @relation(fields: [connectionId, merchantId, provider], references: [id, merchantId, provider])
  sourceOrderId  String?
  checkoutId     String?
  checkout       CommerceCheckout? @relation(fields: [checkoutId, merchantId], references: [id, merchantId], onDelete: Restrict)
  checkoutRef    String?
  paymentRef     String?
  saleAmount     Decimal           @db.Decimal(18, 2)
  saleCurrency   String
  cryptoAmount   Decimal?          @db.Decimal(38, 18)
  cryptoCurrency String?
  // Asset symbols can exist on more than one chain.
  cryptoNetwork  String?
  status         String
  clickId        String?
  click          Click?            @relation(fields: [clickId, merchantId], references: [id, merchantId], onDelete: Restrict)
  commission     Commission?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([merchantId, provider, paymentRef])
  @@unique([merchantId, provider, sourceOrderId])
  // Target of Commission's migration-owned tenant-scoped composite foreign key.
  @@unique([merchantId, id])
  @@index([checkoutId])
  @@index([clickId])
}

/// Historical integration metadata retained for existing event records.
model CommerceIntegration {
  id         String   @id @default(cuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Historical rows retained for referential integrity; runtime delivery is disabled.
  deliveries CommerceEventDelivery[]

  @@unique([id, merchantId])
}

/// Historical outbound event records retained for referential integrity.
/// New rows are not enqueued and these records are not delivered.
model CommerceEventDelivery {
  id                     String                      @id @default(cuid())
  merchantId             String
  merchant               Merchant                    @relation(fields: [merchantId], references: [id])
  integrationId          String
  integration            CommerceIntegration         @relation(fields: [integrationId, merchantId], references: [id, merchantId])
  eventId                String                      @unique
  payload                Json
  status                 CommerceEventDeliveryStatus @default(PENDING)
  attempts               Int                         @default(0)
  lastError              String?
  nextAttemptAt          DateTime                    @default(now())
  checkoutConflictHeldAt DateTime?
  createdAt              DateTime                    @default(now())
  deliveredAt            DateTime?

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, checkoutConflictHeldAt, nextAttemptAt], map: "CommerceEventDelivery_status_conflictHold_nextAttempt_idx")
  @@index([merchantId, createdAt])
}

/// Metadata and normalized digest for a confirmed or preview import. Uploaded
/// bundles are intentionally not persisted.
model AffiliateImportBatch {
  id                  String    @id @default(cuid())
  merchantId          String
  merchant            Merchant  @relation(fields: [merchantId, ownerId], references: [id, ownerId], onDelete: Cascade)
  ownerId             String
  owner               Owner     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceAdapter       String
  sourceFormatVersion Int
  normalizedDigest    String
  mappingChoices      Json?
  previewTotals       Json?
  applyProgress       Json?
  status              String    @default("PREVIEW")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  commissions ImportedCommission[]
  payouts     ImportedPayout[]
  rowResults  AffiliateImportRowResult[]

  @@unique([merchantId, sourceAdapter, normalizedDigest])
  @@unique([id, merchantId])
  @@unique([id, ownerId])
  @@index([merchantId, createdAt])
  @@index([ownerId, createdAt])
}

/// Row-level outcomes for a completed or resumable import report. Stores only
/// stable source identifiers and non-personal status/amount metadata.
model AffiliateImportRowResult {
  id               String               @id @default(cuid())
  batchId          String
  ownerId          String
  batch            AffiliateImportBatch @relation(fields: [batchId, ownerId], references: [id, ownerId], onDelete: Cascade)
  targetMerchantId String?
  targetOwnerId    String?
  targetMerchant   Merchant?            @relation(fields: [targetMerchantId, targetOwnerId], references: [id, ownerId], onDelete: NoAction)
  sourceIdentity   String
  sourceKind       String
  sourceId         String
  outcome          String
  reason           String?
  currency         String?
  amountMinor      BigInt?
  createdAt        DateTime             @default(now())

  @@unique([batchId, sourceIdentity])
  @@index([batchId, sourceKind, outcome])
  @@index([ownerId, batchId, id])
}

/// Immutable imported history, kept outside the operational Commission ledger.
model ImportedCommission {
  id                      String               @id @default(cuid())
  batchId                 String
  ownerId                 String
  batch                   AffiliateImportBatch @relation(fields: [batchId, ownerId], references: [id, ownerId], onDelete: Cascade)
  merchantId              String?
  targetOwnerId           String?
  merchant                Merchant?            @relation(fields: [merchantId, targetOwnerId], references: [id, ownerId], onDelete: NoAction)
  targetProgramId         String?
  affiliateId             String?
  affiliate               Affiliate?           @relation(fields: [affiliateId, merchantId], references: [id, merchantId], onDelete: NoAction)
  targetProgram           Program?             @relation(fields: [targetProgramId, merchantId], references: [id, merchantId], onDelete: NoAction)
  sourceIdentity          String               @unique
  sourceAffiliateIdentity String?
  sourceLinkIdentity      String?
  sourceProductIdentity   String?
  sourceTransactionRef    String?
  amount                  Decimal              @db.Decimal(24, 6)
  amountMinor             BigInt?
  refundedAmount          Decimal?             @db.Decimal(24, 6)
  refundedMinor           BigInt?
  refunds                 Json?
  saleAmount              Decimal?             @db.Decimal(24, 6)
  saleAmountMinor         BigInt?
  currency                String
  originalStatus          String
  allocationStatus        String               @default("UNALLOCATED")
  periodStart             DateTime?
  periodEnd               DateTime?
  sourceCreatedAt         DateTime?
  importedAt              DateTime             @default(now())

  @@index([batchId, importedAt])
  @@index([affiliateId, sourceCreatedAt])
  @@index([merchantId])
  @@index([ownerId, allocationStatus])
}

/// Historical payout snapshots are aggregate records; no individual imported
/// commission is marked paid by inference.
model ImportedPayout {
  id                         String               @id @default(cuid())
  batchId                    String
  ownerId                    String
  batch                      AffiliateImportBatch @relation(fields: [batchId, ownerId], references: [id, ownerId], onDelete: Cascade)
  merchantId                 String?
  targetOwnerId              String?
  merchant                   Merchant?            @relation(fields: [merchantId, targetOwnerId], references: [id, ownerId], onDelete: NoAction)
  targetProgramId            String?
  affiliateId                String?
  affiliate                  Affiliate?           @relation(fields: [affiliateId, merchantId], references: [id, merchantId], onDelete: NoAction)
  targetProgram              Program?             @relation(fields: [targetProgramId, merchantId], references: [id, merchantId], onDelete: NoAction)
  sourceIdentity             String               @unique
  sourceAffiliateIdentity    String?
  sourceProductIdentity      String?
  sourceCommissionIdentities String[]             @default([])
  sourceTransactionRef       String?
  amount                     Decimal              @db.Decimal(24, 6)
  amountMinor                BigInt?
  currency                   String
  originalStatus             String
  allocationStatus           String               @default("UNALLOCATED")
  periodStart                DateTime?
  periodEnd                  DateTime?
  paidAt                     DateTime?
  importedAt                 DateTime             @default(now())

  @@index([batchId, importedAt])
  @@index([affiliateId, paidAt])
  @@index([merchantId])
  @@index([ownerId, allocationStatus])
}
